# ── LLM CONFIGURATION ───────────────────────────────────────
LLM_PROVIDER=anthropic              # anthropic | openai | groq | ollama
# LLM_MODEL overrides the default model for the chosen provider:
#   anthropic → default: claude-sonnet-4-20250514
#   openai    → default: gpt-4o  (recommended: gpt-4.1)
#   groq      → default: qwen3-32b
#   ollama    → always uses qwen2.5:7b / granite3-dense:8b (not overridable)
LLM_MODEL=claude-sonnet-4-20250514
# Single API key for the pinned provider (one provider runs per session):
LLM_API_KEY=                        # key for whichever LLM_PROVIDER is selected
# (Ollama offline models need no API key)
# Optional: provider-specific vars still work and OVERRIDE LLM_API_KEY if set:
#   ANTHROPIC_API_KEY / OPENAI_API_KEY / DEEPSEEK_API_KEY / GROQ_API_KEY / DASHSCOPE_API_KEY

# ── OCR CONFIGURATION ───────────────────────────────────────
OCR_ENGINE=tesseract                # default: Apache 2.0, free — auto-selected per economy YAML; see [Z1-1]/[Z2-1]
AZURE_DI_KEY=...                    # optional: Stage 2 fallback — Azure Document Intelligence
AZURE_DI_ENDPOINT=https://...
MISTRAL_API_KEY=...                 # optional: Stage 2 fallback — Mistral OCR

# ── TRANSLATION CONFIGURATION ───────────────────────────────
DEEPL_API_KEY=...                   # optional: DeepL translation (Google Translate is automatic fallback)

# ── OUTPUT CONFIGURATION ────────────────────────────────────
OUTPUT_DIR=outputs/
LOG_LEVEL=INFO

# ── PROBE CONFIGURATION ──────────────────────────────────────
PROBE_JITTER_MS=300         # max random wait between probe requests (ms); default 300
PROBE_TIMEOUT_SEC=10        # per-request timeout for portal probing; default 10s

# ── CURRENCY CHECK CONFIGURATION (Z1-4) ──────────────────────
CURRENCY_FETCH_TIMEOUT_SEC=15   # timeout for fetching act page (HTML/PDF header); default 15s
CURRENCY_RETRY_WAIT_SEC=5       # wait before retrying 429 during URL validation; default 5s
WAYBACK_RATE_LIMIT_SEC=1.0      # sleep between Wayback Save API calls (max 1 req/sec); default 1.0

# ── CRAWLER CONFIGURATION (Z1-3) ─────────────────────────────
CRAWL_TIMEOUT_MS=15000      # per-page Playwright timeout (ms); default 15000
CRAWL_MAX_DEPTH=2           # BFS depth limit: portal home → listing → document; default 2
CRAWL_MAX_PAGES=5           # max pages per portal per pass; default 5
CRAWL_JITTER_MS=400         # jitter upper bound between page fetches (ms); default 400
MAX_CONCURRENT_CRAWLS=3     # max parallel portal crawls (asyncio.Semaphore); default 3
