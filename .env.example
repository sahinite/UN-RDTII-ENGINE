# ── LLM CONFIGURATION ───────────────────────────────────────
# 7-tier cascade (first available wins); pin one with LLM_PROVIDER:
LLM_PROVIDER=openai              # anthropic | openai | deepseek | groq | qwen | ollama
# LLM_MODEL overrides the default model for the chosen provider:
#   anthropic → default: claude-sonnet-5
#   openai    → default: gpt-4o
#   deepseek  → default: deepseek-chat  (V3, OpenAI-compatible)
#   groq      → default: qwen/qwen3-32b (auto-fallback: qwen/qwen3.6-27b; free tier)
#   qwen      → default: qwen-plus      (via DashScope International)
#   ollama    → default: qwen2.5:7b (tier 6) / granite3-8b (tier 7), offline, Apache 2.0
LLM_MODEL=gpt-4o
# Single API key for the pinned provider (one provider runs per session):
LLM_API_KEY=                        # key for whichever LLM_PROVIDER is selected
# (Ollama offline models need no API key)
# Provider-specific vars OVERRIDE LLM_API_KEY when set (one is enough — the pinned tier):
ANTHROPIC_API_KEY=                  # tier 1
OPENAI_API_KEY=                     # tier 2
DEEPSEEK_API_KEY=                   # tier 3
GROQ_API_KEY=                       # tier 4 (free)
DASHSCOPE_API_KEY=                  # tier 5 (Qwen)
# Ollama (tiers 6/7, offline): run `ollama serve` then pull qwen2.5:7b / granite3-8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192                  # context window — MUST fit the extraction prompt (~4.5k tokens);
                                    # Ollama defaults to 4096 and silently truncates → empty output
# Thinking models (qwen3*, deepseek-r1, qwq) auto-run with think disabled for clean JSON output.
# NOTE: Llama 3.3 is intentionally excluded (non-Apache 2.0 license).

# ── OCR CONFIGURATION ───────────────────────────────────────
OCR_ENGINE=tesseract                # default: Apache 2.0, free — auto-selected per economy YAML; see [Z1-1]/[Z2-1]
AZURE_DI_KEY=...                    # optional: Stage 2 fallback — Azure Document Intelligence
AZURE_DI_ENDPOINT=https://...
MISTRAL_API_KEY=...                 # optional: Stage 2 fallback — Mistral OCR

# ── TRANSLATION CONFIGURATION ───────────────────────────────
DEEPL_API_KEY=...                   # optional: DeepL translation (Google Translate is automatic fallback)

# ── OUTPUT CONFIGURATION ────────────────────────────────────
OUTPUT_DIR=outputs/
LOG_LEVEL=INFO
RDTII_LOG_DIR=logs                  # run logs + diagnostics (mismaps/recall) directory

# ── RUN CONTROL ─────────────────────────────────────────────
RUN_PROFILE=gate                    # gate (KNOWN-only, default) | submit (KNOWN + 3 NEW) | explore (aggressive NEW)
ZONE2_MAX_KNOWN_ACTS=12             # ceiling on KNOWN seed acts fetched per run
ZONE2_MAX_NEW_ACTS=                 # cap on speculative NEW acts (defaults from RUN_PROFILE)
ALLOW_UNVERIFIED_SNIPPETS=false     # true = keep rows whose verbatim snippet failed the source-text assertion (flagged for review)

# ── PROBE CONFIGURATION ──────────────────────────────────────
PROBE_JITTER_MS=300         # max random wait between probe requests (ms); default 300
PROBE_TIMEOUT_SEC=10        # per-request timeout for portal probing; default 10s

# ── CURRENCY CHECK CONFIGURATION (Z1-4) ──────────────────────
CURRENCY_FETCH_TIMEOUT_SEC=15   # timeout for fetching act page (HTML/PDF header); default 15s
CURRENCY_RETRY_WAIT_SEC=5       # wait before retrying 429 during URL validation; default 5s
WAYBACK_RATE_LIMIT_SEC=1.0      # sleep between Wayback Save API calls (max 1 req/sec); default 1.0

# ── CRAWLER CONFIGURATION (Z1-3) ─────────────────────────────
CRAWL_TIMEOUT_MS=15000      # per-page Playwright timeout (ms); default 15000
CRAWL_MAX_DEPTH=2           # BFS depth limit: portal home → listing → document; default 2
CRAWL_MAX_PAGES=5           # max pages per portal per pass; default 5
CRAWL_JITTER_MS=400         # jitter upper bound between page fetches (ms); default 400
MAX_CONCURRENT_CRAWLS=3     # max parallel portal crawls (asyncio.Semaphore); default 3
