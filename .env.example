# ── LLM CONFIGURATION ───────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=sk-ant-...        # required if using anthropic
OPENAI_API_KEY=sk-...               # optional — leave blank to skip
GROQ_API_KEY=gsk_...                # optional — leave blank to skip
# (Ollama offline models need no API key)

# ── OCR CONFIGURATION ───────────────────────────────────────
OCR_ENGINE=tesseract                # default: Apache 2.0, free — auto-selected per economy YAML; see [Z1-1]/[Z2-1]
AZURE_DI_KEY=...                    # optional: Stage 2 fallback — Azure Document Intelligence
AZURE_DI_ENDPOINT=https://...
MISTRAL_API_KEY=...                 # optional: Stage 2 fallback — Mistral OCR

# ── TRANSLATION CONFIGURATION ───────────────────────────────
DEEPL_API_KEY=...                   # optional: DeepL translation (Google Translate is automatic fallback)

# ── OUTPUT CONFIGURATION ────────────────────────────────────
OUTPUT_DIR=outputs/
LOG_LEVEL=INFO
